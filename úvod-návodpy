import random
class Zvire:
    def __init__(self, jmeno:str, vek:int, misto:str = "bouda"):
        self.jmeno = jmeno
        self.vek = vek
        self.misto = misto
        pass
    def zvuk(self):  #potřebuji sám se sebou pracovat (self)
        return "???" #návrat hodnoty

    def predstavSe(self):
        return f"Jmenuji se {self.jmeno}, je mi {self.vek} let."

    def kdeJsi(self):
        return f"Jsem v místě zvaném {self.misto}"

    def jdiNa(self, nMisto:str):
        self.misto = nMisto #self.místo důležité přepsat na novou hodnotu
        return f"Přesunul jsem se na {nMisto}. {self.kdeJsi()}"

class Pes(Zvire):
    def __init__(self, jmeno, vek, plemeno, misto = "bouda"):
        super().__init__(jmeno, vek, misto) #super = podívej se do rodiče, odkazuje na rodiče
        self.plemeno = plemeno

    def zvuk(self):
        return "Haf, Haf!"
    
    def aport(self):
        return f"{self.jmeno} přinesl míček"
    
    def vycesat(self):
        if(random.randint(0,1) > 0):
            return f"{self.jmeno} utekl před tvým kartáček"
        else:
            return f"{self.jmeno} se nechal vyčesat"
        
    def predstavSe(self):
        return f"{super().predstavSe()} jsem {self.plemeno}" #print se nedoporučuje, jinak bychom toto nemohli udělat
    
class Papousek(Zvire):
    def __init__(self, jmeno, barva_peri, vek, misto = "klec"):
        super().__init__(jmeno, vek, misto)
        self.barva_peri = barva_peri
        pass

    def zvuk(self):
        return "Krák krák!"
    
    def opakuj(self, slovo:str):
        return f"{self.jmeno} opakuje {slovo}!, {slovo}!"
    
class Had(Zvire):
    def __init__(self, jmeno, vek, delka_v_cm:int, jedovaty:bool, misto = "klec"):
        super().__init__(jmeno, vek, misto)
        self.delka_v_cm = delka_v_cm
        self.jedovaty = jedovaty
        pass

    def zvuk(self):
        return "Ssssss!"
    
    def ustknuti(self, jedovaty):
        if self.jedovaty:
            return f"Pozor! {self.jmeno} tě uštknul a je jedovatý"
        else:
            return f"Pozor! {self.jmeno} to kousnul, ale naštěstí není jedovatý"
        
    def predstavSe(self):
        if self.jedovaty:
            typ = "jedovatý"
        else:
            typ = "škrtič"
        
        return f"Ssssss ... já jsem {self.jmeno}, měřím {self.delka_v_cm} a jsem {typ}"
        
